{
  "entity": "MJ: User Notification Types",
  "filePattern": "**/.*.json",
  "defaults": {},
  "pull": {
    "createNewFileIfNotFound": true,
    "newFileName": ".task-notification-types.json",
    "appendRecordsToExistingFile": true,
    "updateExistingRecords": true,
    "preserveFields": [],
    "excludeFields": [],
    "mergeStrategy": "merge",
    "backupBeforeUpdate": true,
    "backupDirectory": ".backups",
    "filter": "Name IN ('Task Completed', 'Task Overdue')",
    "ignoreNullFields": true,
    "ignoreVirtualFields": true,
    "lookupFields": {
      "EmailTemplateID": {
        "entity": "MJ: Templates",
        "field": "Name"
      }
    },
    "relatedEntities": {}
  }
}
