    "fields": {
      "Name": "Post Task Assignment to Teams",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Tasks",
      "Description": "Posts a card naming a newly assigned task and its assignee to a Microsoft Teams channel. Set it as a Task Type's OnAssign action. The channel's webhook URL comes from a 'Teams Channel Webhook' credential: the one named in CredentialName, else the one named after the task type's Code, else the credential type's default. Accepts Office 365 connector and Power Automate Workflows webhook URLs.",
      "Type": "Custom",
      "DriverClass": "Tasks.PostAssignmentToTeams",
      "IconClass": "fa-solid fa-comments",
      "UserPrompt": "Post a task assignment to a Teams channel.",
      "CodeApprovalStatus": "Approved",
      "Status": "Active"
    },
