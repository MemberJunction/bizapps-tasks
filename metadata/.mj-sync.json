{
  "version": "1.0.0",
  "push": {
    "autoCreateMissingRecords": true
  },
  "directoryOrder": [
    "applications",
    "task-types",
    "task-roles",
    "task-decision-outcomes",
    "task-notification-configs"
  ],
  "emitSyncNotes": false,
  "sqlLogging": {
    "enabled": true,
    "outputDirectory": "./sql_logging",
    "formatAsMigration": true,
    "filterPatterns": ["*spCreateAIPromptRun*", "*spUpdateAIPromptRun*"],
    "filterType": "exclude"
  }
}
